{
  "name": "@dasignature/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DaSignature iOS/Android shell (Capacitor). Wraps the apps/web build.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cap": "cap",
    "sync:android": "pnpm --filter @dasignature/web build && cap sync android",
    "sync:ios": "pnpm --filter @dasignature/web build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
