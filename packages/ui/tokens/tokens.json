{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "DaSignature design tokens - SOURCE OF TRUTH (W3C DTCG format). $value = light; $extensions['app.dasignature'].dark = dark. source 'spec-8.2'/'spec-11' = owner values, never edit; 'designer' = aliases ({color.x}) of spec colors or one pinned success tint (PM #47); ink.* = approved signature ink colors (PM #44). PM decision #31 light rules: accent never text; text-muted only on bg/surface; success never text. Regenerate: python3 build.py && python3 check_contrast.py",
  "primitive": {
    "$description": "Brand palette (SPEC Sec 11). Not for direct UI use; use semantic color tokens.",
    "navy": {
      "$type": "color",
      "$value": "#141A3C",
      "$extensions": {
        "app.dasignature": {
          "source": "spec-11"
        }
      }
    },
    "feather": {
      "$type": "color",
      "$value": "#F6F3EC",
      "$extensions": {
        "app.dasignature": {
          "source": "spec-11"
        }
      }
    },
    "gold": {
      "$type": "color",
      "$value": "#E8B04A",
      "$extensions": {
        "app.dasignature": {
          "source": "spec-11"
        }
      }
    }
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#FAFAF8",
      "$description": "App background",
      "$extensions": {
        "app.dasignature": {
          "dark": "#0E1126",
          "source": "spec-8.2",
          "css": "--bg"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Cards, panels, sheets",
      "$extensions": {
        "app.dasignature": {
          "dark": "#161B3A",
          "source": "spec-8.2",
          "css": "--surface"
        }
      }
    },
    "surface-2": {
      "$type": "color",
      "$value": "#F1F1EE",
      "$description": "Inset/secondary surface, inputs, chips",
      "$extensions": {
        "app.dasignature": {
          "dark": "#1D2347",
          "source": "spec-8.2",
          "css": "--surface-2"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "#141A3C",
      "$description": "Primary text",
      "$extensions": {
        "app.dasignature": {
          "dark": "#F2F1EC",
          "source": "spec-8.2",
          "css": "--text"
        }
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "#6B7090",
      "$description": "Secondary text. LIGHT RULE (PM #31): only on bg and surface; on surface-2 use text.",
      "$extensions": {
        "app.dasignature": {
          "dark": "#A3A8C8",
          "source": "spec-8.2",
          "css": "--text-muted",
          "rule": "light: allowed on bg, surface only"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "#E4E4EC",
      "$description": "Hairline dividers and card edges (decorative, below 3:1). Form-control boundaries use border-strong.",
      "$extensions": {
        "app.dasignature": {
          "dark": "#2A3163",
          "source": "spec-8.2",
          "css": "--border"
        }
      }
    },
    "primary": {
      "$type": "color",
      "$value": "#141A3C",
      "$description": "Primary button fill / primary emphasis",
      "$extensions": {
        "app.dasignature": {
          "dark": "#E8B04A",
          "source": "spec-8.2",
          "css": "--primary"
        }
      }
    },
    "on-primary": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Text/icons on primary",
      "$extensions": {
        "app.dasignature": {
          "dark": "#141A3C",
          "source": "spec-8.2",
          "css": "--on-primary"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#E8B04A",
      "$description": "Gold accent, sparingly. LIGHT RULE (PM #31): never text; fills (with text label), borders, focus/selection rings, icons only. Dark: may be text or a fill with on-primary label. Gold is decorative/emphasis only on light, never the sole state cue (PM #33).",
      "$extensions": {
        "app.dasignature": {
          "dark": "#E8B04A",
          "source": "spec-8.2",
          "css": "--accent",
          "rule": "light: never text"
        }
      }
    },
    "danger": {
      "$type": "color",
      "$value": "#C23B3B",
      "$description": "Destructive text/fill",
      "$extensions": {
        "app.dasignature": {
          "dark": "#F07C7C",
          "source": "spec-8.2",
          "css": "--danger"
        }
      }
    },
    "success": {
      "$type": "color",
      "$value": "#2E8B6A",
      "$description": "Success. LIGHT RULE (PM #31): never text; status = success icon or success-chip-bg fill with text label.",
      "$extensions": {
        "app.dasignature": {
          "dark": "#5CCB9E",
          "source": "spec-8.2",
          "css": "--success",
          "rule": "light: never text"
        }
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.text}",
      "$description": "Label on an accent (gold) fill. Light = text (#141A3C, 8.64:1); dark = on-primary (#141A3C). Never on-primary in light (white on gold 1.96:1).",
      "$extensions": {
        "app.dasignature": {
          "dark": "{color.on-primary}",
          "source": "designer",
          "css": "--on-accent"
        }
      }
    },
    "on-danger": {
      "$type": "color",
      "$value": "{color.on-primary}",
      "$description": "Label on a danger fill (#FFFFFF light / #141A3C dark).",
      "$extensions": {
        "app.dasignature": {
          "dark": "{color.on-primary}",
          "source": "designer",
          "css": "--on-danger"
        }
      }
    },
    "border-strong": {
      "$type": "color",
      "$value": "{color.text-muted}",
      "$description": "Form-control boundaries where the outline is the only indicator (input, checkbox, toggle): WCAG 1.4.11 >= 3:1. Alias of a spec color, no new hex.",
      "$extensions": {
        "app.dasignature": {
          "dark": "{color.text-muted}",
          "source": "designer",
          "css": "--border-strong"
        }
      }
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{color.primary}",
      "$description": "Keyboard focus outline: light = primary navy (gold is 1.96:1 on light surfaces, below the 3:1 focus-indicator minimum); dark = accent gold.",
      "$extensions": {
        "app.dasignature": {
          "dark": "{color.accent}",
          "source": "designer",
          "css": "--focus-ring",
          "approved": "PM #33"
        }
      }
    },
    "success-chip-bg": {
      "$type": "color",
      "$value": "#DEECE7",
      "$description": "APPROVED (PM #32), PINNED HEX (PM #47). Status chip fill for 'signed' (= 16% success tinted into surface, frozen); label = text; optional success icon. QA checks exact match.",
      "$extensions": {
        "app.dasignature": {
          "dark": "#21374A",
          "source": "designer",
          "css": "--success-chip-bg",
          "approved": "PM #32; pinned PM #47",
          "derivedFrom": {
            "of": "success",
            "pct": 16,
            "into": "surface",
            "note": "Pinned (PM #47) to the exact 8-bit result of color-mix(in srgb, success 16%, surface) per theme, verified by Chromium render; visuals unchanged."
          }
        }
      }
    },
    "selection": {
      "$type": "color",
      "$value": "{color.accent}",
      "$description": "Placement selection outline (Sec 7.4 gold, brand). 2 px, with a 1 px selection-halo inside it. Handles: pdf-page fill + 1.5 px pdf-ink stroke (16.9:1) carry the state cue (PM #33).",
      "$extensions": {
        "app.dasignature": {
          "dark": "{color.accent}",
          "source": "designer",
          "css": "--selection",
          "approved": "PM #33"
        }
      }
    },
    "selection-halo": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "1 px inner halo just inside the gold selection outline, so the selection reads on any page color (PM #33). Theme-independent.",
      "$extensions": {
        "app.dasignature": {
          "dark": "#FFFFFF",
          "source": "designer",
          "css": "--selection-halo",
          "approved": "PM #33"
        }
      }
    },
    "pdf-page": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "PDF page backing. Never inverted in dark mode (Sec 8.2). Same as light surface.",
      "$extensions": {
        "app.dasignature": {
          "dark": "#FFFFFF",
          "source": "designer",
          "css": "--pdf-page"
        }
      }
    },
    "pdf-ink": {
      "$type": "color",
      "$value": "#141A3C",
      "$description": "On-page ink for field previews (Date/Text/Checkbox) and selection-handle strokes. Theme-independent (= brand navy, Sec 11).",
      "$extensions": {
        "app.dasignature": {
          "dark": "#141A3C",
          "source": "designer",
          "css": "--pdf-ink"
        }
      }
    },
    "canvas": {
      "$type": "color",
      "$value": "{color.surface-2}",
      "$description": "Editor backdrop behind pages; dims chrome in dark. Light = surface-2, so labels on it use text (not text-muted).",
      "$extensions": {
        "app.dasignature": {
          "dark": "{color.bg}",
          "source": "designer",
          "css": "--canvas"
        }
      }
    },
    "scrim": {
      "$type": "color",
      "$value": "rgba(20, 26, 60, 0.40)",
      "$description": "Overlay behind sheets/modals (navy at 40%).",
      "$extensions": {
        "app.dasignature": {
          "dark": "rgba(5, 7, 18, 0.64)",
          "source": "designer",
          "css": "--scrim"
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter Variable",
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Inter variable, BUNDLED (OFL). No remote fonts."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "System mono for SHA-256 hashes (no download)."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    }
  },
  "typography": {
    "$description": "Scale 12/14/16/20/28/36 (Sec 8.2). Line heights on 4 pt grid. rem-based for dynamic type.",
    "caption": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.75rem",
        "lineHeight": "1rem",
        "letterSpacing": "0.01em",
        "fontWeight": 400
      },
      "$description": "12/16"
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "0.875rem",
        "lineHeight": "1.25rem",
        "letterSpacing": "0em",
        "fontWeight": 400
      },
      "$description": "14/20"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "1rem",
        "lineHeight": "1.5rem",
        "letterSpacing": "0em",
        "fontWeight": 400
      },
      "$description": "16/24 (base)"
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "1.25rem",
        "lineHeight": "1.75rem",
        "letterSpacing": "-0.01em",
        "fontWeight": 600
      },
      "$description": "20/28"
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontSize": "1.75rem",
        "lineHeight": "2.25rem",
        "letterSpacing": "-0.02em",
        "fontWeight": 600
      },
      "$description": "28/36"
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontSize": "2.25rem",
        "lineHeight": "2.75rem",
        "letterSpacing": "-0.022em",
        "fontWeight": 600
      },
      "$description": "36/44"
    },
    "wordmark-tracking": {
      "$type": "dimension",
      "$value": "-0.02em",
      "$description": "Tight tracking for the DaSignature wordmark (Sec 11)"
    }
  },
  "space": {
    "$description": "4 pt grid. Keys = multiples of 4 px (Tailwind-compatible numbering).",
    "0": {
      "$type": "dimension",
      "$value": "0rem"
    },
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "2rem",
      "$description": "32 px (same value as the fine-pointer target, PM #52)"
    },
    "10": {
      "$type": "dimension",
      "$value": "2.5rem"
    },
    "11": {
      "$type": "dimension",
      "$value": "2.75rem",
      "$description": "44 px = touch target (PM #16)"
    },
    "12": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "16": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "20": {
      "$type": "dimension",
      "$value": "5rem"
    },
    "24": {
      "$type": "dimension",
      "$value": "6rem"
    }
  },
  "size": {
    "touch": {
      "$type": "dimension",
      "$value": "2.75rem",
      "$description": "44 px: min target for coarse (touch) pointers. PM #16/#52."
    },
    "target-fine": {
      "$type": "dimension",
      "$value": "2rem",
      "$description": "32 px: min target when the primary pointer is fine (mouse/trackpad), at any width. PM #52."
    },
    "target": {
      "$type": "dimension",
      "$value": "2.75rem",
      "$description": "Adaptive min target keyed on the PRIMARY pointer only, at any viewport width (PM #52): 44 px by default and for pointer: coarse; 32 px for pointer: fine. Hybrid devices follow their primary pointer.",
      "$extensions": {
        "app.dasignature": {
          "media": [
            {
              "query": "(pointer: coarse)",
              "value": "2.75rem"
            },
            {
              "query": "(pointer: fine)",
              "value": "2rem"
            }
          ],
          "decision": "PM #52 (replaces the PM #16 width + any-pointer condition)"
        }
      }
    },
    "hairline": {
      "$type": "dimension",
      "$value": "1px"
    },
    "focus-ring-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "focus-ring-offset": {
      "$type": "dimension",
      "$value": "2px"
    },
    "selection-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "selection-halo-width": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "Inner halo width (PM #33)"
    },
    "handle": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Visible handle square; hit area is size.target (padded)."
    },
    "handle-stroke": {
      "$type": "dimension",
      "$value": "1.5px",
      "$description": "pdf-ink stroke on selection handles (PM #33)"
    }
  },
  "radius": {
    "input": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Inputs, buttons, chips-in-forms"
    },
    "card": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Cards, popovers, desktop modals"
    },
    "sheet": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Bottom sheets (top corners), phone full-screen sheet"
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Pills, status chips, toasts"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms",
        "$description": "Hover, press, toggles, fades"
      },
      "base": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Panels, popovers, toasts"
      },
      "sheet": {
        "$type": "duration",
        "$value": "400ms",
        "$description": "Spring sheets (settles ~300 ms; spring exception to 150-200 ms rule)"
      }
    },
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.2,
          1
        ],
        "$description": "Default ease-out"
      },
      "spring": {
        "$type": "cubicBezier",
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$description": "Fallback approximation; CSS uses linear() spring generated from spring params",
        "$extensions": {
          "app.dasignature": {
            "spring": {
              "stiffness": 380,
              "damping": 30,
              "mass": 1
            }
          }
        }
      }
    },
    "reduced-motion": {
      "$type": "other",
      "$value": "all durations -> 0ms, springs -> none; opacity cross-fades allowed at 0ms",
      "$description": "prefers-reduced-motion: reduce OR [data-motion=reduce]"
    }
  },
  "elevation": {
    "$description": "Flat: elevation = surface step + hairline border. Shadows almost never (Sec 8.1).",
    "none": {
      "$type": "shadow",
      "$value": "none"
    },
    "float": {
      "$type": "other",
      "$value": "0 4px 16px rgba(20, 26, 60, 0.08)",
      "$description": "The ONLY shadow: floating placement toolbar over the PDF page. Dark: none (use border instead).",
      "$extensions": {
        "app.dasignature": {
          "dark": "none"
        }
      }
    }
  },
  "breakpoint": {
    "$description": "Sec 8.3: phone <600, tablet 600-1024, desktop >1024. Mobile-first min-widths. Prefer container queries for panels.",
    "tablet": {
      "$type": "dimension",
      "$value": "600px"
    },
    "desktop": {
      "$type": "dimension",
      "$value": "1025px"
    },
    "wide": {
      "$type": "dimension",
      "$value": "1440px"
    },
    "ultra": {
      "$type": "dimension",
      "$value": "2560px"
    }
  },
  "viewport": {
    "$description": "QA visual matrix (PM #14). Reference only, not CSS. Landscape = swapped dims for 320, 390, 768.",
    "$value": [
      "320x568",
      "390x844",
      "768x1024",
      "1024x768",
      "1440x900",
      "2560x1440"
    ],
    "$type": "other"
  },
  "ink": {
    "$description": "Signature ink colors (SPEC 7.2 defaults; hex approved PM #44, D5). Theme-independent: content colors rendered on the white PDF page / signature previews, never UI chrome. Each >= 7:1 on #FFFFFF and --pdf-page.",
    "black": {
      "$type": "color",
      "$value": "#1B1F2A",
      "$description": "Ink black",
      "$extensions": {
        "app.dasignature": {
          "source": "designer",
          "css": "--ink-black",
          "approved": "PM #44",
          "themeIndependent": true,
          "minContrastOnPage": 7.0
        }
      }
    },
    "blue": {
      "$type": "color",
      "$value": "#1F3A8A",
      "$description": "Ink blue",
      "$extensions": {
        "app.dasignature": {
          "source": "designer",
          "css": "--ink-blue",
          "approved": "PM #44",
          "themeIndependent": true,
          "minContrastOnPage": 7.0
        }
      }
    },
    "deep-red": {
      "$type": "color",
      "$value": "#8B1E2B",
      "$description": "Deep red",
      "$extensions": {
        "app.dasignature": {
          "source": "designer",
          "css": "--ink-deep-red",
          "approved": "PM #44",
          "themeIndependent": true,
          "minContrastOnPage": 7.0
        }
      }
    },
    "graphite": {
      "$type": "color",
      "$value": "#4B4F58",
      "$description": "Graphite",
      "$extensions": {
        "app.dasignature": {
          "source": "designer",
          "css": "--ink-graphite",
          "approved": "PM #44",
          "themeIndependent": true,
          "minContrastOnPage": 7.0
        }
      }
    }
  }
}
